{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-new-func": "off",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-post-message-target-origin": "off",
    "react/no-array-index-key": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expectEquivalent"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "react/*",
                  "next",
                  "next/*",
                  "@/features/*",
                  "@/app/*",
                  "@/machine/*",
                  "@/hooks/*"
                ],
                "message": "The execution engine must stay independent of React, Next.js and the UI."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [".next/**", "node_modules/**", "next-env.d.ts"]
}
